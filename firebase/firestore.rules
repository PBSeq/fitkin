rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // v6: + 운영자 ban(banned/{uid} 존재 = 발행·사진·메시지 전면 정지, 관리 토큰만 쓴다)
    //     + 프로필 사진(photo)·운동 사진 피드(photos)
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }
    match /banned/{uid} {
      allow read, write: if false;   // 운영자(관리 토큰) 전용
    }

    // 문서 ID = auth.uid. 본인만 쓰기, 프로필 읽기는 공개(매칭이 제품).
    // zip 은 5자리 숫자만 — GPS 없이 성긴 위치로 동네·근처 매칭.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && notBanned()
                    && request.resource.data.keys().hasOnly(['name','sports','vibe','days','zip','ts','photo','cell','cell4','hidden'])
                    && (!('hidden' in request.resource.data) || request.resource.data.hidden == true)
                    && (!('photo' in request.resource.data)
                        || (request.resource.data.photo is string
                            && request.resource.data.photo.size() <= 300000
                            && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
                    && request.resource.data.keys().hasAll(['name','sports','vibe','days','ts'])
                    && (('zip' in request.resource.data) || ('cell' in request.resource.data))
                    && (('cell' in request.resource.data) == ('cell4' in request.resource.data))
                    && (!('cell' in request.resource.data)
                        || (request.resource.data.cell is string
                            && request.resource.data.cell.matches('^[0-9b-hjkmnp-z]{5}$')
                            && request.resource.data.cell4 is string
                            && request.resource.data.cell4.matches('^[0-9b-hjkmnp-z]{4}$')
                            && request.resource.data.cell.matches('^' + request.resource.data.cell4 + '.*')))
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 30
                    && (!('zip' in request.resource.data)
                        || (request.resource.data.zip is string
                            && request.resource.data.zip.matches('^[0-9]{5}$')))
                    && request.resource.data.sports is list
                    && request.resource.data.sports.size() >= 1
                    && request.resource.data.sports.size() <= 12
                    && request.resource.data.days is list
                    && request.resource.data.days.size() <= 7
                    && request.resource.data.vibe is map
                    && request.resource.data.vibe.keys().hasOnly(['time','mode','level'])
                    && (!('time' in request.resource.data.vibe)
                        || (request.resource.data.vibe.time is string && request.resource.data.vibe.time.size() <= 20))
                    && (!('mode' in request.resource.data.vibe)
                        || (request.resource.data.vibe.mode is string && request.resource.data.vibe.mode.size() <= 20))
                    && (!('level' in request.resource.data.vibe)
                        || (request.resource.data.vibe.level is string && request.resource.data.vibe.level.size() <= 20))
                    && request.resource.data.ts is number;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 킨 링크: 당사자만 생성·조회. 소셜 그래프는 공개하지 않는다.
    // resource == null 허용: 미존재 문서 getDoc 은 exists=false 로 답해야
    // 신규 연결 흐름(존재 확인 → 생성)이 작동한다.
    match /links/{id} {
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid == resource.data.a
                      || request.auth.uid == resource.data.b);
      allow create: if request.auth != null
                    && notBanned()
                    && request.resource.data.keys().hasOnly(['a','b','ts'])
                    && (request.auth.uid == request.resource.data.a
                        || request.auth.uid == request.resource.data.b)
                    && request.resource.data.a != request.resource.data.b
                    && exists(/databases/$(database)/documents/profiles/$(request.resource.data.a))
                    && exists(/databases/$(database)/documents/profiles/$(request.resource.data.b))
                    && id == (request.resource.data.a < request.resource.data.b
                              ? request.resource.data.a + '_' + request.resource.data.b
                              : request.resource.data.b + '_' + request.resource.data.a)
                    && request.resource.data.ts is number
                    && request.resource.data.ts >= request.time.toMillis() - 300000
                    && request.resource.data.ts <= request.time.toMillis() + 300000;
      allow update, delete: if false;
    }

    // 차단: blocks/{차단자uid}/users/{대상uid}. 차단자만 만들고 지우고 조회한다.
    // 경로 세그먼트 기반이라 컬렉션 쿼리도 규칙이 정적으로 증명된다.
    // 대상은 자기가 차단당했는지 조회할 수 없다 (괴롭힘 방지).
    match /blocks/{uid}/users/{otherId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['ts']);
      allow update: if false;
    }

    // 메시지: 킨(링크 당사자)만 읽고 쓴다 — 진짜 프라이빗.
    // 상대가 나를 차단했으면 보낼 수 없다 (Apple 1.2 안전장치).
    match /messages/{linkId}/msgs/{mid} {
      function link() {
        return get(/databases/$(database)/documents/links/$(linkId)).data;
      }
      function isParty() {
        return request.auth != null
               && (request.auth.uid == link().a || request.auth.uid == link().b);
      }
      function otherUid() {
        return request.auth.uid == link().a ? link().b : link().a;
      }
      allow read: if isParty();
      allow create: if isParty()
                    && notBanned()
                    && !exists(/databases/$(database)/documents/blocks/$(otherUid())/users/$(request.auth.uid))
                    && request.resource.data.keys().hasOnly(['from','text','ts'])
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 200
                    && request.resource.data.ts is number;
      allow update, delete: if false;
    }

    // 운동 사진 피드(moments): 근처 공개. 본인만 올리고 본인만 지운다.
    // 이미지는 JPEG data URL 인라인(Storage 결제 없이 무료 티어로) — 700KB 상한.
    match /photos/{id} {
      allow read: if request.auth != null;   // 사진은 로그인(익명 포함) 사용자에게만 — 무인증 전수수집 차단
      allow create: if request.auth != null
                    && notBanned()
                    && request.resource.data.keys().hasOnly(['owner','name','zip','cell','cell4','img','caption','ts'])
                    && request.resource.data.owner == request.auth.uid
                    && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 30
                    && (('zip' in request.resource.data) || ('cell' in request.resource.data))
                    && (!('zip' in request.resource.data)
                        || (request.resource.data.zip is string
                            && request.resource.data.zip.matches('^[0-9]{5}$')))
                    && (('cell' in request.resource.data) == ('cell4' in request.resource.data))
                    && (!('cell' in request.resource.data)
                        || (request.resource.data.cell is string
                            && request.resource.data.cell.matches('^[0-9b-hjkmnp-z]{5}$')
                            && request.resource.data.cell4 is string
                            && request.resource.data.cell4.matches('^[0-9b-hjkmnp-z]{4}$')
                            && request.resource.data.cell.matches('^' + request.resource.data.cell4 + '.*')))
                    && request.resource.data.img is string
                    && request.resource.data.img.size() <= 700000
                    && request.resource.data.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 100
                    && request.resource.data.ts is number;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if false;
    }

    // 피드백/컴플레인 창구: 누구나(인증 사용자) 제출, 열람·대응은 운영자만.
    match /feedback/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['by','text','contact','app','ts'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.contact is string
                    && request.resource.data.contact.size() <= 100
                    && request.resource.data.app is string
                    && request.resource.data.app.size() <= 10
                    && request.resource.data.ts is number;
      allow read, update, delete: if false;
    }


    // 킨 리뷰 (v1.2 · 설계 LOCKED 2026-08-28): 킨만, 킨당 1회(docId 강제), 별점 3~5,
    // 더블 블라인드를 규칙으로 강제 — 미공개 리뷰는 작성자 외 SDK 직쿼리로도 못 읽는다.
    match /reviews/{id} {
      function lnkId() {
        return request.resource.data.from < request.resource.data.to
          ? request.resource.data.from + '_' + request.resource.data.to
          : request.resource.data.to + '_' + request.resource.data.from;
      }
      allow read: if request.auth != null
                  && (resource == null
                      || resource.data.from == request.auth.uid
                      || resource.data.visibleAfter <= request.time.toMillis());
      allow create: if request.auth != null
                    && notBanned()
                    && request.resource.data.keys().hasOnly(['from','to','linkId','stars','tags','comment','levelCheck','ts','visibleAfter'])
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.from != request.resource.data.to
                    && id == request.auth.uid + '_' + request.resource.data.to
                    && request.resource.data.linkId == lnkId()
                    && exists(/databases/$(database)/documents/links/$(lnkId()))
                    && get(/databases/$(database)/documents/links/$(lnkId())).data.ts + 86400000 <= request.time.toMillis()
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 3
                    && request.resource.data.stars <= 5
                    && request.resource.data.tags is list
                    && request.resource.data.tags.size() <= 5
                    && request.resource.data.tags.hasOnly(['on-time','great-energy','matched-level','good-communicator','would-train-again','pushes-me','patient-teacher'])
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 140
                    && request.resource.data.levelCheck in ['','new-ish','steady','serious']
                    && request.resource.data.ts is number
                    && request.resource.data.visibleAfter is number
                    && request.resource.data.visibleAfter >= request.resource.data.ts
                    && request.resource.data.visibleAfter <= request.resource.data.ts + 1209600000;
      allow update: if request.auth != null
                    && notBanned()
                    && resource.data.from == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['stars','tags','comment','levelCheck','visibleAfter'])
                    && request.resource.data.tags is list
                    && request.resource.data.comment is string
                    && request.resource.data.visibleAfter is number
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 3
                    && request.resource.data.stars <= 5
                    && request.resource.data.tags.size() <= 5
                    && request.resource.data.tags.hasOnly(['on-time','great-energy','matched-level','good-communicator','would-train-again','pushes-me','patient-teacher'])
                    && request.resource.data.comment.size() <= 140
                    && request.resource.data.levelCheck in ['','new-ish','steady','serious']
                    && request.resource.data.visibleAfter >= resource.data.ts
                    && request.resource.data.visibleAfter <= resource.data.ts + 1209600000;
      // 작성자만 삭제. 수신 리뷰 청산은 관리자 경로(moderate.py cleanorphans) — 클라 권한 최소화
      allow delete: if request.auth != null
                    && resource.data.from == request.auth.uid;
    }

    // 신고: 인앱 제출(본인 명의만). 열람은 운영자(관리 토큰)만 — 클라이언트 read 금지.
    match /reports/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['by','about','reason','ts'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 300;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
