rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // v2 (Codex 외부감사 반영): 서버에 비밀키를 두지 않는다.
    // 프로필은 생성 후 불변 — 덮어쓰기 공격면 자체를 제거.
    // '카드 다시 만들기'는 새 문서를 만든다 (클라이언트 설계와 일치).
    match /profiles/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','sports','vibe','days','hood','ts'])
                    && request.resource.data.keys().hasAll(['name','sports','vibe','days','hood','ts'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.hood is string
                    && request.resource.data.hood.size() <= 40
                    && request.resource.data.sports is list
                    && request.resource.data.sports.size() <= 12
                    && request.resource.data.days is list
                    && request.resource.data.ts is number;
      allow update, delete: if false;   // 불변. 삭제는 운영자(privacy 절차)만.
    }

    // 킨 링크: 두 프로필이 실재할 때만 생성 가능. 불변.
    match /links/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['a','b','ts'])
                    && request.resource.data.a is string
                    && request.resource.data.b is string
                    && request.resource.data.a != request.resource.data.b
                    && exists(/databases/$(database)/documents/profiles/$(request.resource.data.a))
                    && exists(/databases/$(database)/documents/profiles/$(request.resource.data.b))
                    && id == (request.resource.data.a < request.resource.data.b
                              ? request.resource.data.a + '_' + request.resource.data.b
                              : request.resource.data.b + '_' + request.resource.data.a);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
